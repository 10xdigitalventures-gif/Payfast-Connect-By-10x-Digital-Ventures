# Application
NEXT_PUBLIC_APP_URL=https://payfast.10xdigitalventures.com
SESSION_SECRET=replace_with_a_random_32_plus_character_secret

# Primary GHL OAuth App (PayFast)
GHL_CLIENT_ID=your_payfast_ghl_client_id
GHL_CLIENT_SECRET=your_payfast_ghl_client_secret
GHL_SHARED_SECRET=your_payfast_ghl_shared_secret
GHL_APP_TOKEN=your_payfast_marketplace_app_token
GHL_PROVIDER_LOGO_URL=https://payfast.10xdigitalventures.com/logo.png

# 10x Whop App — separate GHL Marketplace App
WHOP_GHL_CLIENT_ID=your_whop_ghl_client_id
WHOP_GHL_CLIENT_SECRET=your_whop_ghl_client_secret
WHOP_GHL_SHARED_SECRET=your_whop_ghl_shared_secret
WHOP_GHL_APP_TOKEN=your_whop_ghl_marketplace_app_token
WHOP_GHL_WEBHOOK_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nreplace_with_key\n-----END PUBLIC KEY-----

# GHL Agency OAuth App
AGENCY_GHL_CLIENT_ID=your_agency_ghl_client_id
AGENCY_GHL_CLIENT_SECRET=your_agency_ghl_client_secret
AGENCY_GHL_SHARED_SECRET=your_agency_ghl_shared_secret
AGENCY_GHL_APP_TOKEN=your_agency_marketplace_app_token

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=payfast_ghl

# PayFast Pakistan environment routing
PAYFAST_DEFAULT_ENV=sandbox
PAYFAST_LIVE_TOKEN_URL=https://ipg1.apps.net.pk/Ecommerce/api/Transaction/GetAccessToken
PAYFAST_LIVE_POST_URL=https://ipg1.apps.net.pk/Ecommerce/api/Transaction/PostTransaction
PAYFAST_SANDBOX_TOKEN_URL=https://ipguat.apps.net.pk/Ecommerce/api/Transaction/GetAccessToken
PAYFAST_SANDBOX_POST_URL=https://ipguat.apps.net.pk/Ecommerce/api/Transaction/PostTransaction

# Swich credentials and hosted checkout URLs are stored from Agency Settings.
# Swich callback: https://payfast.10xdigitalventures.com/api/swich/callback
# Obtain exact sandbox/live checkout URLs and credentials from Swich onboarding.

# Whop Payments
WHOP_API_KEY=your_whop_api_key
WHOP_COMPANY_ID=biz_your_company_id
WHOP_WEBHOOK_SECRET=whsec_your_webhook_secret
WHOP_DEFAULT_EXCHANGE_RATE=280
WHOP_DEFAULT_FEE_PERCENT=0
